// ---------- CONFIG ----------
const TABLE_NAME = "Info Collection";
const VIEW_NAME = "DNT - Get Call Transcript";
const SOURCE_URL_FIELD = "RecordingUrl (from exotelMapper)";
const TARGET_TEXT_FIELD = "icCallTranscript";

const OPENAI_TRANSCRIBE_URL = "https://api.openai.com/v1/audio/transcriptions";
const OPENAI_MODEL = "whisper-1";
const LIMIT_RECORDS = 10;

// ---------- SECRETS ----------
const OPENAI_API_KEY = "";
const AUTH_USERNAME = "";
const AUTH_PASSWORD = "";

// ---------- POLYFILLS ----------
class TextEncoderPolyfill {
  encode(str) {
    const utf8 = [];
    for (let i = 0; i < str.length; i++) {
      let charcode = str.charCodeAt(i);
      if (charcode < 0x80) utf8.push(charcode);
      else if (charcode < 0x800) utf8.push(0xc0 | (charcode >> 6), 0x80 | (charcode & 0x3f));
      else if (charcode < 0xd800 || charcode >= 0xe000) utf8.push(
        0xe0 | (charcode >> 12),
        0x80 | ((charcode >> 6) & 0x3f),
        0x80 | (charcode & 0x3f)
      );
      else {
        i++;
        const code = 0x10000 + (((charcode & 0x3ff) << 10) | (str.charCodeAt(i) & 0x3ff));
        utf8.push(
          0xf0 | (code >> 18),
          0x80 | ((code >> 12) & 0x3f),
          0x80 | ((code >> 6) & 0x3f),
          0x80 | (code & 0x3f)
        );
      }
    }
    return new Uint8Array(utf8);
  }
}
const TextEncoder = TextEncoderPolyfill;

// Base64 encode
function base64Encode(str) {
  if (typeof btoa !== 'undefined') {
    return btoa(str);
  }
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
  let output = '';
  let i = 0;
  const bytes = Array.from(new TextEncoder().encode(str));
  
  while (i < bytes.length) {
    const b1 = bytes[i++] || 0;
    const b2 = bytes[i++] || 0;
    const b3 = bytes[i++] || 0;
    const e1 = b1 >> 2;
    const e2 = ((b1 & 3) << 4) | (b2 >> 4);
    const e3 = ((b2 & 15) << 2) | (b3 >> 6);
    const e4 = b3 & 63;
    
    if (i - 1 >= bytes.length + 1) {
      output += chars[e1] + chars[e2] + "==";
    } else if (i - 1 === bytes.length) {
      output += chars[e1] + chars[e2] + chars[e3] + "=";
    } else {
      output += chars[e1] + chars[e2] + chars[e3] + chars[e4];
    }
  }
  return output;
}

// ---------- HELPERS ----------
async function fetchAsArrayBuffer(url) {
  // Create Basic Auth header
  const authString = `${AUTH_USERNAME}:${AUTH_PASSWORD}`;
  const authHeader = "Basic " + base64Encode(authString);
  
  const resp = await fetch(url, {
    method: "GET",
    headers: {
      "Authorization": authHeader
    },
    mode: "cors"
  });

  if (!resp.ok) {
    const errText = await resp.text().catch(() => "");
    throw new Error(`Failed to fetch audio: ${resp.status} ${resp.statusText} - ${errText}`);
  }

  return await resp.arrayBuffer();
}

function buildMultipartBody(arrayBuffer, filename, fields) {
  const boundary = "----AirtableBoundary" + Math.random().toString(16).slice(2);
  const enc = new TextEncoder();

  const chunks = [];
  const pushText = (s) => chunks.push(enc.encode(s));
  const pushBytes = (u8) => chunks.push(u8);

  // file
  pushText(`--${boundary}\r\n`);
  pushText(`Content-Disposition: form-data; name="file"; filename="${filename}"\r\n`);
  pushText(`Content-Type: audio/mpeg\r\n\r\n`);
  pushBytes(new Uint8Array(arrayBuffer));
  pushText(`\r\n`);

  // fields
  for (const [name, value] of Object.entries(fields)) {
    if (value === undefined || value === null) continue;
    pushText(`--${boundary}\r\n`);
    pushText(`Content-Disposition: form-data; name="${name}"\r\n\r\n`);
    pushText(String(value) + `\r\n`);
  }

  // end
  pushText(`--${boundary}--\r\n`);

  // concat
  const total = chunks.reduce((sum, c) => sum + c.length, 0);
  const body = new Uint8Array(total);
  let offset = 0;
  for (const c of chunks) {
    body.set(c, offset);
    offset += c.length;
  }

  return {
    contentTypeHeader: `multipart/form-data; boundary=${boundary}`,
    bodyUint8: body,
  };
}

async function transcribeArrayBuffer(arrayBuffer, filename = "recording.mp3") {
  const { contentTypeHeader, bodyUint8 } = buildMultipartBody(arrayBuffer, filename, {
    model: OPENAI_MODEL,
  });

  const resp = await fetch(OPENAI_TRANSCRIBE_URL, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${OPENAI_API_KEY}`,
      "Content-Type": contentTypeHeader,
    },
    body: bodyUint8,
  });

  if (!resp.ok) {
    const errText = await resp.text().catch(() => "");
    throw new Error(`OpenAI API error: ${resp.status} ${resp.statusText} - ${errText}`);
  }

  const data = await resp.json();
  return data.text || "";
}

////////////////////////////////////////////////////////////////////////////////
// MAIN
////////////////////////////////////////////////////////////////////////////////
const table = base.getTable(TABLE_NAME);
const view = table.getView(VIEW_NAME);

console.log(`Reading: ${TABLE_NAME} → ${VIEW_NAME}`);
const query = await view.selectRecordsAsync({ fields: [SOURCE_URL_FIELD, TARGET_TEXT_FIELD] });
const records = query.records.slice(0, LIMIT_RECORDS);

let considered = 0;
let updated = 0;

for (const record of records) {
  considered += 1;

  try {
    const url = record.getCellValueAsString(SOURCE_URL_FIELD);
    const existing = record.getCellValueAsString(TARGET_TEXT_FIELD);

    // Skip if no URL or already has text
    if (!url || url.trim() === "") {
      console.log(`Skip ${record.id}: no URL`);
      continue;
    }
    if (existing && existing.trim().length > 0) {
      console.log(`Skip ${record.id}: already transcribed`);
      continue;
    }

    // Fetch and transcribe
    console.log(`Fetching recording for ${record.id}`);
    const bytes = await fetchAsArrayBuffer(url);
    
    console.log(`Transcribing ${record.id}`);
    const transcript = await transcribeArrayBuffer(bytes, "recording.mp3");

    // WRITE IMMEDIATELY (no batching)
    await table.updateRecordAsync(record.id, {
      [TARGET_TEXT_FIELD]: transcript || ""
    });

    updated += 1;
    console.log(`✅ Updated ${record.id} (total updated: ${updated})`);
  } catch (e) {
    console.log(`❌ Error on record ${record.id}: ${e.message}`);
  }
}

console.log(`Done. Considered: ${considered} (limit ${LIMIT_RECORDS}). Updated: ${updated}.`);

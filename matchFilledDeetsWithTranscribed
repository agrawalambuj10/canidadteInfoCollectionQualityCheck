const OPENAI_MODEL = "gpt-4o-mini";
const OPENAI_MAX_TOKENS = 1200;
const OPENAI_TEMPERATURE = 0.0;

const MAX_TEXT = 60000;

/* ================= CLEAN TEXT ================= */

function clean(str) {
  if (!str) return "";
  return String(str).replace(/\u0000/g, "").slice(0, MAX_TEXT);
}

/* ================= JSON PARSER ================= */

function tryParseFirstJson(text) {
  if (!text) return { ok: false };

  let output = String(text)
    .replace(/^```json|```$/g, "")
    .replace(/^```|```$/g, "");

  const first = output.indexOf("{");
  const last = output.lastIndexOf("}");

  if (first === -1 || last === -1) return { ok: false };

  try {
    return { ok: true, json: JSON.parse(output.slice(first, last + 1)) };
  } catch {
    return { ok: false };
  }
}

/* ================= OPENAI CALL ================= */

async function callOpenAI(prompt) {
  const resp = await fetch("https://api.openai.com/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${OPENAI_API_KEY}`
    },
    body: JSON.stringify({
      model: OPENAI_MODEL,
      temperature: OPENAI_TEMPERATURE,
      max_tokens: OPENAI_MAX_TOKENS,
      response_format: { type: "json_object" },
      messages: [
        { role: "system", content: "Return ONLY JSON." },
        { role: "user", content: prompt }
      ]
    })
  });

  return resp.json();
}

